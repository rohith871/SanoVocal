# SanoVocal Environment Configuration Template
SANOVOCAL_HOST=0.0.0.0
SANOVOCAL_PORT=8000
SANOVOCAL_UI_PORT=8501

# Model & Hardware Settings
CUDA_VISIBLE_DEVICES=0
DEVICE_PREFERENCE=cuda

# Persistent Storage
SQLITE_DB_PATH=data/sanovocal.db
# Optional: Supabase configuration (if running in cloud sync mode)
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_KEY=your_service_role_key
